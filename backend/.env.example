# Copy this file to `.env` and set your MongoDB connection string.
# Example local URI:
#   MONGO_URI=mongodb://127.0.0.1:27017/task_manager
# Example Atlas URI:
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task_manager
MONGO_URI=your_mongodb_connection_string_here

# JWT secret used to sign access tokens.
JWT_SECRET=replace_with_a_long_random_string

# In-memory cache (Practical 9).
# CACHE_ENABLED=false turns the cache off so uncached timings can be recorded
# with the same build; CACHE_TTL_SECONDS is the entry lifetime in seconds.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Groq API key (Practical 13 - AI description generation).
# Server-side ONLY; never committed to git. If left empty, the AI feature
# falls back to a friendly message instead of crashing (graceful degradation).
GROQ_API_KEY=gsk_...
